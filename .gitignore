# 配置文件（含 DeepSeek API Key，切勿上传）
config.json

# 日志与 Python 缓存
logs/
__pycache__/
*.pyc

# tools/ 大部分为缓存/测试夹具，不入库；仅放行“克隆即玩”所需资产：
#   goods_measure.json     （运行时量词表）
#   rakaly.exe             （熔 .v3 存档，免去另装）
#   build_state_food_palette.py / build_food_zones.py （升级游戏后重建 zone 数据）
#   gen_country_sphere.py  （升级游戏后重建 data/country_sphere.json 文风文化圈表）
#   test_style_sphere.py   （文风文化圈轴离线回归自检）
tools/*
!tools/goods_measure.json
!tools/rakaly.exe
!tools/build_state_food_palette.py
!tools/build_food_zones.py
!tools/gen_country_sphere.py
!tools/test_style_sphere.py
Source/

# 会话生成输出统一输出到 output/（报纸/杂志/原始 JSON 一律不入库）
output/
**/报纸_*.md

# 开发文档（仅本机使用，不上传 GitHub）
docs/

# 编辑器 / 系统文件
.idea/
.vscode/
.DS_Store
Thumbs.db

# 个人研究 / 实验 / 草稿（与本项目无关，其他用户无用）
_hac/
_hac_wayback/
_hac_readme.md
_hac_repo.json
_hac_tree.json
Hollywood_Animal_Calculator_研究报告.md
_scratch/
expck3/
_test_pool/
